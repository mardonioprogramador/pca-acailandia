# Copie para .env e preencha localmente. Nunca versione valores reais.
POSTGRES_USER=pca
POSTGRES_DB=pca
POSTGRES_PASSWORD=
# A senha na URL deve ser codificada para URL quando contiver caracteres especiais.
DATABASE_URL=
API_PORT=3001
NODE_ENV=development
SECURE_COOKIES=false
# Origem exata do navegador (protocolo, host e porta). No Compose use http://localhost:3001.
APP_ORIGIN=http://localhost:5173
# Somente para o comando admin:criar; retire a senha após a execução.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
# Opcional: banco EXCLUSIVO para testes. Se ausente, npm test cria um contêiner descartável.
TEST_DATABASE_URL=

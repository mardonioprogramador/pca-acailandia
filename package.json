{
  "name": "pca-acailandia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build -w @pca/shared && concurrently -k -n api,web \"npm run dev -w @pca/api\" \"npm run dev -w @pca/web\"",
    "build": "npm run build -w @pca/shared && npm run build -w @pca/api && npm run build -w @pca/web",
    "start": "npm run start -w @pca/api",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build -w @pca/shared && npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @pca/shared && npm run db:generate",
    "test": "node scripts/testar.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "predb:seed": "npm run build -w @pca/shared",
    "db:seed": "tsx --import dotenv/config apps/api/src/seed.ts",
    "preadmin:criar": "npm run build -w @pca/shared",
    "admin:criar": "tsx --import dotenv/config apps/api/src/admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.0",
    "concurrently": "9.2.5",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "dotenv": "16.6.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
